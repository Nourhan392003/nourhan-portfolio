# nourhan-portfolio · AI Recruiter backend configuration (TEMPLATE)
# ============================================================
# Copy this file to `.env` and fill in the real values, then set the SAME
# variables in the host's dashboard (Vercel → Project → Settings →
# Environment Variables). `.env` is git-ignored; this template is not.
#
# NEVER commit the real key, and never paste it into config.js, any
# front-end file, or a chat message. The key is only read server-side by
# api/chat.js and is never sent to the browser.
# ============================================================

# Required — the Gemini API key from Google AI Studio (aistudio.google.com).
# Create one under "Get API key". Billing is separate from any consumer
# Gemini/ChatGPT subscription.
GEMINI_API_KEY=

# Optional — the model the backend calls. Defaults to gemini-3.5-flash when
# unset. Verify current availability for your account before changing it.
GEMINI_MODEL=gemini-3.5-flash
